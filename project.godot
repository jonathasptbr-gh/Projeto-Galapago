; Projeto Galápago — configuração do Godot 4.7.
; Resolução interna de pixel art (320x180), ampliada por inteiro: nada de
; filtro, nada de meio pixel. Renderizador de compatibilidade (OpenGL/GLES 3):
; é o que roda em celular modesto E o que o oráculo de quadros consegue
; renderizar sem GPU (ver docs/ORACULO.md).

config_version=5

[application]

config/name="Projeto Galápago"
run/main_scene="res://jogo/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
