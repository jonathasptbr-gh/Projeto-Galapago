; Projeto Galápago — configuração do Godot 4.7.
; Tela em ALTA resolução e RETRATO (720x1280 base, `canvas_items`, aspecto
; `expand` para preencher telas altas de celular); a ARTE é pixelada (filtro
; nearest, câmera com zoom inteiro), mas linhas, sombras e efeitos são lisos
; (desenho antialiasing na resolução da tela). Decisão do operador, 2026-11-20
; (v0.6.0; era paisagem 1280x720 até a v0.5).
; Renderizador MOBILE (Vulkan), alvo do celular médio; aparelho sem Vulkan cai
; para OpenGL 3 (Compatibility) por `rendering_device/fallback_to_opengl3`.
; O oráculo sobrepõe pela linha de comando: prévia local em Compatibility
; (softpipe), verdade no CI em Vulkan (lavapipe). Decisão do operador,
; 2026-11-25 (P24; era gl_compatibility até então). Ver docs/ORACULO.md.

config_version=5

[application]

config/name="Projeto Galápago"
config/version="local"
run/main_scene="res://jogo/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[galapago]

; Número do build do CI (versionCode do APK). 0 = rodando fora de um APK do CI;
; o tools/android/exportar.sh grava o número certo só durante o export.
build=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; true é o padrão do 4.7.2; explícito porque é decisão (Vulkan ausente → OpenGL 3)
rendering_device/fallback_to_opengl3=true
; Sombra do sol (S5a): atlas 4096 e filtro suave "low" (2) IGUAIS na chave
; base (CI/desktop, o oráculo) e na `.mobile` (o APK; padrões 2048 e 0 = duro,
; que serrilhava). Câmera ortográfica: o atlas inteiro cobre só a fatia
; near..far justa da vista (jogo/mundo3d/vista.gd), ~40 unidades na vista alta.
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
